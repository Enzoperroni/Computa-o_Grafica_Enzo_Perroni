import numpy as np
import matplotlib.pyplot as plt

# =========================
# Funções matemáticas
# =========================

def translate(points, tx, ty):
    T = np.array([[1, 0, tx],
                  [0, 1, ty],
                  [0, 0, 1]])
    return apply_transform(points, T)

def scale(points, sx, sy=None):
    if sy is None:
        sy = sx
    S = np.array([[sx, 0,  0],
                  [0,  sy, 0],
                  [0,  0,  1]])
    return apply_transform(points, S)

def rotate(points, angle_degrees, clockwise=False):
    theta = np.deg2rad(angle_degrees)
    if clockwise:
        theta = -theta
    cos_t, sin_t = np.cos(theta), np.sin(theta)
    R = np.array([[cos_t, -sin_t, 0],
                  [sin_t,  cos_t, 0],
                  [0,      0,     1]])
    return apply_transform(points, R)

def reflect_x(points):
    M = np.array([[1,  0, 0],
                  [0, -1, 0],
                  [0,  0, 1]])
    return apply_transform(points, M)

def reflect_y(points):
    M = np.array([[-1, 0, 0],
                  [0,  1, 0],
                  [0,  0, 1]])
    return apply_transform(points, M)

def shear_x(points, k):
    Sh = np.array([[1, k, 0],
                   [0, 1, 0],
                   [0, 0, 1]])
    return apply_transform(points, Sh)

def apply_transform(points, M):
    pts = np.array(points, dtype=float)
    if pts.ndim == 1:
        pts = pts.reshape(1, 2)
    ones = np.ones((pts.shape[0], 1))
    hom = np.hstack([pts, ones])
    result = (M @ hom.T).T
    return result[:, :2]

# =========================
# Funções de plot
# =========================

def plot_points(original, transformed, labels=("Original", "Transformado"),
                title="Transformação de ponto"):
    orig = np.array(original).reshape(-1, 2)
    transf = np.array(transformed).reshape(-1, 2)

    plt.figure()
    plt.axhline(0, color="black", linewidth=0.5)
    plt.axvline(0, color="black", linewidth=0.5)

    plt.scatter(orig[:, 0], orig[:, 1], marker='o', label=labels[0])
    plt.scatter(transf[:, 0], transf[:, 1], marker='x', label=labels[1])

    if orig.shape == transf.shape:
        for (x0, y0), (x1, y1) in zip(orig, transf):
            plt.arrow(x0, y0, x1 - x0, y1 - y0,
                      head_width=0.1, length_includes_head=True)

    plt.legend()
    plt.title(title)
    plt.grid(True)
    plt.axis('equal')
    plt.show()

def plot_polygon(original, transformed, labels=("Original", "Transformado"),
                 title="Transformação de polígono"):
    orig = np.array(original)
    transf = np.array(transformed)

    if not np.allclose(orig[0], orig[-1]):
        orig = np.vstack([orig, orig[0]])
    if not np.allclose(transf[0], transf[-1]):
        transf = np.vstack([transf, transf[0]])

    plt.figure()
    plt.axhline(0, color="black", linewidth=0.5)
    plt.axvline(0, color="black", linewidth=0.5)

    plt.plot(orig[:, 0], orig[:, 1], marker='o', label=labels[0])
    plt.plot(transf[:, 0], transf[:, 1], marker='x--', label=labels[1])

    plt.legend()
    plt.title(title)
    plt.grid(True)
    plt.axis('equal')
    plt.show()

